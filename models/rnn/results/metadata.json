{
  "model": "rnn",
  "dataset": "sklearn.datasets.load_breast_cancer",
  "seed": 42,
  "positive_class": "maligno",
  "target_mapping": {
    "benigno": 0,
    "maligno": 1
  },
  "split": {
    "train": 0.6,
    "validation": 0.2,
    "test": 0.2
  },
  "split_stratified": true,
  "threshold": 0.5,
  "selection_metric": "validation_f1",
  "selected_step": 70,
  "features": [
    "mean radius",
    "mean texture",
    "mean perimeter",
    "mean area",
    "mean smoothness",
    "mean compactness",
    "mean concavity",
    "mean concave points",
    "mean symmetry",
    "mean fractal dimension",
    "radius error",
    "texture error",
    "perimeter error",
    "area error",
    "smoothness error",
    "compactness error",
    "concavity error",
    "concave points error",
    "symmetry error",
    "fractal dimension error",
    "worst radius",
    "worst texture",
    "worst perimeter",
    "worst area",
    "worst smoothness",
    "worst compactness",
    "worst concavity",
    "worst concave points",
    "worst symmetry",
    "worst fractal dimension"
  ],
  "preprocessing": "StandardScaler ajustado somente no treino",
  "sequence_length": 1,
  "units": {
    "gini_class_impurity": "0–0,5 (binário)",
    "gini_importance": "importância normalizada (0–1)",
    "eda_features": "desvios padrão da média do treino",
    "units_note": "Estatísticas originais: unidades do dataset_description.txt",
    "metrics": "escore adimensional (0–1)",
    "probabilities": "0–1",
    "processed_features": "desvios padrão em relação à média do treino",
    "confusion_matrix": "amostras",
    "shap": "probabilidade da classe positiva (0–1)",
    "saliency": "logit por unidade de entrada padronizada",
    "integrated_gradients": "logit"
  },
  "colors": {
    "treino": "#2563EB",
    "validacao": "#D97706",
    "teste": "#059669",
    "saliency": "#7C3AED",
    "integrated_gradients": "#0891B2",
    "shap": "#7C3AED",
    "benigno": "#2563EB",
    "maligno": "#D97706",
    "dados": "#2563EB",
    "gini": "#7C3AED"
  },
  "font": "DejaVu Sans",
  "python": "3.12.13",
  "versions": {
    "numpy": "2.5.2",
    "pandas": "3.0.5",
    "scikit-learn": "1.9.0",
    "matplotlib": "3.11.1",
    "joblib": "1.5.3",
    "torch": "2.13.0+cu126",
    "captum": "0.9.0"
  },
  "test_used_for_selection": false,
  "limitations": [
    "Demonstração educacional com uma única divisão e uma semente.",
    "RNN/LSTM com um passo não avaliam dependências temporais.",
    "Explicações descrevem o modelo, não causalidade ou decisão clínica."
  ]
}